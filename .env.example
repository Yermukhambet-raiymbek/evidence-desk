# Generate your own token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_API_TOKEN=replace-with-at-least-24-random-characters
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./var/evidence.sqlite
# Optional: documents used in Ollama mode are transmitted to this operator-configured endpoint.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
