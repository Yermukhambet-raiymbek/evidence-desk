{
  "name": "evidence-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first document Q&A with immutable line citations and retrieval evaluation",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "evaluate": "node scripts/evaluate.ts",
    "demo": "node scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "typescript": "5.9.3"
  }
}
